# Environment variables for local development
# Copy this file to .env and fill in your actual values

# YouTube API Credentials
# Get these from Google Cloud Console
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# Pinterest API Credentials
# Get these from Pinterest Developer Portal
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token_here

# Timezone for scheduling uploads
# Use IANA timezone format (e.g., America/New_York, Europe/London)
TIMEZONE=America/New_York
